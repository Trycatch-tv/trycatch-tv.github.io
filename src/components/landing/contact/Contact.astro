---
import { Icon } from "astro-icon/components"
---

<section id="contacto" aria-labelledby="contacto-title" class="landing-section">
  <div class="landing-shell">
    <div class="landing-header">
      <p class="landing-eyebrow">Hablemos</p>
      <h2 id="contacto-title" class="landing-title">Contacto</h2>
      <p class="landing-lead">Si en algo puedo ayudarte, no dudes en contactarme.</p>
    </div>
    <div class="landing-grid landing-three-grid">
      {[
        { title: "Correo", label: "judlup@trycatch.tv", href: "mailto:judlup@trycatch.tv", icon: "mdi:email-outline" },
        { title: "LinkedIn", label: "in/judlup", href: "https://www.linkedin.com/in/judlup/", icon: "mdi:linkedin" },
        { title: "Instagram", label: "@TryCatch_tv", href: "https://www.instagram.com/trycatch_tv/", icon: "mdi:instagram" },
      ].map((link) => (
        <a href={link.href} target={link.href.startsWith("https://") ? "_blank" : undefined} rel={link.href.startsWith("https://") ? "noopener noreferrer" : undefined} class="landing-card block">
          <Icon name={link.icon} class="landing-icon mb-4" />
          <h3 class="landing-card-title mb-2">{link.title}</h3>
          <p class="landing-copy landing-contact-address">{link.label}</p>
        </a>
      ))}
    </div>
  </div>
</section>
