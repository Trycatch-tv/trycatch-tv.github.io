---
import { Icon } from "astro-icon/components"
---

<section id="builder-center" aria-labelledby="builder-center-title" class="landing-section landing-band">
  <div class="landing-shell flex flex-col lg:flex-row lg:items-center gap-6">
    <div class="flex items-start gap-4 flex-1 min-w-0">
      <Icon name="fa-brands:aws" class="w-12 h-12 shrink-0 text-tc-yellow" />
      <div>
        <h2 id="builder-center-title" class="landing-card-title">También nos encontramos en AWS Builder Center</h2>
        <p class="landing-lead mt-3">
          Sígueme y lee mis publicaciones sobre tecnología, desarrollo de software y aprendizajes con la comunidad.
        </p>
      </div>
    </div>
    <a
      href="https://builder.aws.com/community/@judlup?tab=badges"
      target="_blank"
      rel="noopener noreferrer"
      class="landing-button landing-button-primary self-start lg:self-center shrink-0"
    >
      Seguir y leer a Julián
      <Icon name="mdi:arrow-top-right" class="w-4 h-4 shrink-0" />
    </a>
  </div>
</section>
