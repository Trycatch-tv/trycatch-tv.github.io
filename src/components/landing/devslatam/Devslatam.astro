---
import { Icon } from "astro-icon/components"

const info = {
  title: "Devs Latam",
  subtitle:
    "Una plataforma impulsada por la comunidad para desarrolladores de América Latina. Aprende, colabora y crece profesionalmente participando en proyectos, eventos y mentorías.",
  stats: [
    { value: "+1000", label: "Personas" },
    { value: "+15", label: "Países" },
    { value: "+35", label: "Proyectos" },
  ],
}
---

<section class="landing-section">
  <div class="landing-shell">
    <div class="landing-section-content">
      <div class="landing-header">
        <span
          class="landing-eyebrow"
        >
          COMUNIDAD LATAM
        </span>
        <h2
          class="landing-title flex justify-center items-center gap-3"
        >
          <Icon class="landing-icon" name="mdi:account-group" />
          <span>{info.title}</span>
        </h2>
        <p
          class="landing-lead"
        >
          {info.subtitle}
        </p>
      </div>

      <div>
        <div
          class="landing-grid landing-stats-grid"
        >
          {
            info.stats.map((stat) => (
              <article class="landing-card text-center min-h-[120px] flex flex-col justify-center">
                <h3 class="text-3xl font-bold text-white">
                  {stat.value}
                </h3>
                <p class="text-base text-gray-300 mt-1">{stat.label}</p>
              </article>
            ))
          }
        </div>
      </div>

    </div>
  </div>
</section>
