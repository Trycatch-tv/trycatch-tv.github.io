---
import { Icon } from "astro-icon/components"
const info = {
  title: "Tipos de Contenido",
  description:
    "En TryCatch.tv compartimos contenido variado pensado para impulsar tu crecimiento profesional y técnico. Estos son algunos de los formatos que puedes encontrar:",
  contentTypes: [
    {
      icon: "mdi:play-circle-outline",
      title: "Videos educativos",
      href: "https://www.youtube.com/@trycatch_tv/videos",
      action: "Ver videos",
      description:
        "Tutoriales, análisis de herramientas y conceptos clave de desarrollo y arquitectura.",
    },
    {
      icon: "mdi:television-play",
      title: "Transmisiones en vivo",
      href: "https://www.twitch.tv/trycatch_tv",
      action: "Ir a Twitch",
      description:
        "Sesiones interactivas con la comunidad resolviendo dudas, creando proyectos y compartiendo experiencias.",
    },
    {
      icon: "mdi:lightning-bolt-outline",
      title: "Shorts y tips",
      href: "https://www.youtube.com/@trycatch_tv/shorts",
      action: "Ver shorts",
      description:
        "Videos breves con hacks, recomendaciones y reflexiones del mundo tech.",
    },
    {
      icon: "mdi:book-open-outline",
      title: "Lecturas en comunidad",
      href: "https://www.youtube.com/playlist?list=PL4LOq_2-aO28TOeq36k5omDrdER8uZno2",
      action: "Ver lecturas",
      description:
        "Club de lectura de libros sobre software, soft skills y liderazgo.",
    },
    {
      icon: "mdi:bullhorn-outline",
      title: "Divulgación y opinión",
      href: "https://medium.trycatch.tv/",
      action: "Leer artículos",
      description:
        "Noticias, comentarios y reflexiones sobre lo que pasa en la industria de la tecnología.",
    },
    {
      icon: "mdi:microphone-outline",
      title: "Entrevistas",
      href: "https://www.youtube.com/playlist?list=PL4LOq_2-aO28SPi1PJ11Js1CnbfHDnjel",
      action: "Ver entrevistas",
      description:
        "Conversaciones con personas referentes del ecosistema tech sobre sus historias y aprendizajes.",
    },
  ],
}
---

<section id="contenido" aria-labelledby="contenido-title" class="landing-section">
  <div class="landing-shell">
    <div
      class="landing-section-content"
    >
      <div class="landing-header">
        <span
          class="landing-eyebrow"
        >
          FORMATO TRY CATCH
        </span>
        <h2
          id="contenido-title"
          class="landing-title"
        >
          {info.title}
        </h2>
        <p
          class="landing-lead"
        >
          {info.description}
        </p>
      </div>

      <div
        class="landing-grid landing-content-grid"
      >
        {
          info.contentTypes.map((item) => (
            <article class="landing-card min-h-[240px] flex flex-col">
              <div class="mb-4">
                <Icon name={item.icon} class="landing-icon" />
              </div>
              <h3 class="landing-card-title mb-3">
                {item.title}
              </h3>
              <p class="landing-copy">
                {item.description}
              </p>
              <a
                href={item.href}
                target={item.href.startsWith("https://") ? "_blank" : undefined}
                rel={item.href.startsWith("https://") ? "noopener noreferrer" : undefined}
                class="mt-auto pt-5 inline-flex items-center gap-2 text-tc-yellow text-sm font-semibold hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-tc-yellow"
              >
                {item.action}
                <Icon name="mdi:arrow-right" class="w-4 h-4" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
