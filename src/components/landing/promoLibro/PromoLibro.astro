---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import FirstBookCover from "../../../assets/img/libro/portada_libro_guía_completa.jpg"
import SecondBookCover from "../../../assets/img/libro/Portada_como_conseguir_primer_trabajo.jpg"
const info = {
  title: "¡Ya disponible!",
  subtitle: "Guía completa: Cómo iniciar en el desarrollo de software",
  description:
    "Aprende desde cero cómo prepararte para tu primer trabajo como desarrollador. Un libro pensado para quienes quieren entrar al mundo tech con bases sólidas.",
  cta: "Comprar libro",
  ctaLink:
    "https://store.trycatch.tv/index.php/product/libro-fisico-guia-completa-como-iniciar-en-el-desarrollo-de-software-preventa-en-colombia/",
  image:
    "https://s3.us-west-2.amazonaws.com/store.trycatch.tv/wp-content/uploads/2025/04/23095930/Portada-libro-guia-para-iniciar-en-desarrollo-de-software.jpg",
}
const book2 = {
  title: "Cómo Conseguir el Primer Trabajo en Tecnología",
  subtitle: "Guía completa para conseguir tu primer empleo en tecnología",
  description:
    "Estrategias prácticas, ejercicios y rutas de aprendizaje para posicionarte y conseguir tu primera oportunidad en el sector tech.",
  cta: "Comprar libro",
  ctaLink:
    "https://store.trycatch.tv/producto/libro-guia-completa-como-conseguir-el-primer-trabajo-en-tecnologia/",
  image:
    "https://s3.us-west-2.amazonaws.com/store.trycatch.tv/wp-content/uploads/2026/04/27003549/Portada.jpg",
}
---

<section id="libros" aria-labelledby="libros-title" class="landing-section">
  <div class="landing-shell">
    <div class="landing-header">
      <p class="landing-eyebrow">Libros de Julián Luna</p>
      <h2 id="libros-title" class="landing-title">Crece en tu carrera tech</h2>
    </div>
    <div class="landing-grid landing-book-grid">
      {[
        { title: "Cómo iniciar en el desarrollo de software", description: info.description, cover: FirstBookCover, href: info.ctaLink, details: "/libro-como-iniciar-en-el-desarrollo-de-software" },
        { title: book2.title, description: book2.description, cover: SecondBookCover, href: book2.ctaLink, details: "/libro-como-conseguir-el-primer-trabajo-en-tecnologia" },
      ].map((book) => (
        <article class="landing-card landing-book">
          <Image src={book.cover} alt={`Portada de ${book.title}`} width={280} class="landing-book-cover" />
          <div class="flex flex-col h-full min-w-0">
            <h3 class="landing-card-title mb-3">{book.title}</h3>
            <p class="landing-copy mb-6">{book.description}</p>
            <div class="landing-actions mt-auto">
              <a href={book.href} target="_blank" rel="noopener noreferrer" class="landing-button landing-button-primary">
                Comprar libro <Icon name="mdi:arrow-top-right" class="w-4 h-4 shrink-0" />
              </a>
              <a href={book.details} class="landing-button landing-button-secondary">
                Ver detalles <Icon name="mdi:book-open-outline" class="w-4 h-4 shrink-0" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
