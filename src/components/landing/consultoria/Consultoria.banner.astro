---
import { Icon } from "astro-icon/components"

const info = {
  title: "Consultoría",
  subtitle:
    "Acompañamiento estratégico para tomar mejores decisiones, fortalecer tu perfil y avanzar con claridad en tu carrera o negocio.",
  products: [
    {
      badge: "Estrategia empresarial",
      icon: "mdi:briefcase-outline",
      accent: "#e8edac",
      title: "Consultoría Empresarial",
      description:
        "Soluciones claras y accionables para definir prioridades, destrabar decisiones y avanzar con una hoja de ruta inmediata.",
      price: "$ 800.000",
      href: "https://store.trycatch.tv/producto/consultoria-empresarial/",
    },
    {
      badge: "Acompañamiento 1:1",
      icon: "mdi:account-outline",
      accent: "#7dd3d8",
      title: "Mentorías personalizadas",
      description:
        "Sesiones enfocadas en tus objetivos para ayudarte a resolver bloqueos, validar ideas y acelerar tu crecimiento profesional.",
      price: "$ 400.000",
      href: "https://store.trycatch.tv/producto/mentoria-personalizadas/",
    },
    {
      badge: "Marca profesional",
      icon: "mdi:card-account-details-outline",
      accent: "#f2b4cb",
      title: "Revisión de Perfil",
      description:
        "Optimiza tu perfil para destacar frente a reclutadores, clientes y oportunidades que realmente quieras aprovechar.",
      price: "$ 100.000",
      href: "https://store.trycatch.tv/producto/revision-de-perfil/",
    },
  ],
}
---

<section id="consultoria" aria-labelledby="consultoria-title" class="landing-section">
  <div class="landing-shell">
    <div class="landing-section-content">
      <div class="landing-header">
        <span class="landing-eyebrow">
          Store TryCatch.tv
        </span>
        <h2 id="consultoria-title" class="landing-title">
          {info.title}
        </h2>
        <p class="landing-lead">
          {info.subtitle}
        </p>
      </div>

      <div class="landing-grid landing-three-grid">
        {info.products.map((product) => (
          <article class="landing-card service-card" style={`--service-accent: ${product.accent}`}>
            <header class="mb-4">
              <Icon name={product.icon} class="service-icon w-9 h-9 mb-4" />
              <p class="text-gray-300 text-xs font-semibold leading-relaxed mb-2">
                {product.badge}
              </p>
              <h3 class="service-title text-xl font-bold text-white leading-snug">
                {product.title}
              </h3>
            </header>
            <p class="text-gray-300 text-sm leading-relaxed mb-6">
              {product.description}
            </p>
            <div class="mt-auto pt-5 border-t border-gray-700">
              <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-white mb-1">
                <span class="text-2xl font-bold">{product.price}</span>
                <span class="text-xs text-gray-300">COP</span>
              </p>
              <p class="text-xs text-gray-400 mb-5">Valor único</p>
              <a
                href={product.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Comprar ${product.title}`}
                class="landing-button landing-button-primary w-full"
              >
                Comprar ahora
                <Icon name="mdi:arrow-top-right" class="w-4 h-4 shrink-0" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem;
    border-top: 3px solid var(--service-accent);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .service-card:hover,
  .service-card:focus-within {
    border-color: var(--service-accent);
    box-shadow: 0 8px 24px rgb(0 0 0 / 18%);
  }

  .service-icon {
    color: var(--service-accent);
  }

  @media (min-width: 1024px) {
    .service-title {
      min-height: 3.5rem;
    }
  }
</style>
