---
import profile from "../../../assets/img/profile.jpg"
import Button from "../../global/ui/button.astro"
import { Image } from "astro:assets"

const info = {
  altProfile: "Julián Luna, creador de TryCatch.tv",
  title: "Bienvenido Trycker",
  subtitle: "Aprender haciendo 👨‍💻.",
  description:
    "Soy Julián Luna, AWS Community Builder con más de 10 años en tecnología. Aprende conmigo desarrollo de software, arquitectura y habilidades blandas, y conecta con una comunidad que crece contigo.",
  daughterName: "❤ Nikol Daniela",
  ctas: [
    {
      text: "Unirme a la comunidad",
      link: "/tryckers",
    },
    {
      text: "Ver contenido",
      link: "#contenido",
    },
  ],
}
---

<section class="mt-24">
  <div class="px-4 lg:mx-auto lg:max-w-screen-2xl">
    <div
      class="bg-tc-black border border-gray-700 rounded-lg p-6 lg:p-12 mb-8 shadow-lg text-center"
    >
      <!-- Imagen de perfil -->
      <div class="flex justify-center">
        <Image
          src={profile}
          alt={info.altProfile}
          width={240}
          height={240}
          loading="eager"
          fetchpriority="high"
          class="w-28 h-28 lg:w-60 lg:h-60 object-cover rounded-full shadow-md transition-transform transform hover:scale-105"
        />
      </div>

      <!-- Información del perfil -->
      <div class="mt-6 max-w-5xl mx-auto">
        <h1
          class="text-tc-gray-l text-3xl lg:text-5xl font-extrabold leading-tight"
        >
          {info.title}
        </h1>
        <p class="text-base lg:text-xl text-tc-gray mt-3">{info.subtitle}</p>
        <p
          class="text-tc-gray-l pt-4 pb-2 text-base lg:text-xl leading-relaxed text-center mx-auto max-w-[60ch]"
        >
          {info.description}
        </p>
        <p class="text-tc-yellow font-semibold mt-3">{info.daughterName}</p>
      </div>

      <!-- Botones de CTA -->
      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 max-w-md mx-auto">
        {
          info.ctas.map((cta) => (
            <Button buttonText={cta.text} buttonLink={cta.link} />
          ))
        }
      </div>
    </div>
  </div>
</section>
