---
import profile from "../../../assets/img/profile.jpg"
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"

const info = {
  altProfile: "Julián Luna, creador de TryCatch.tv",
  title: "Bienvenido Trycker",
  subtitle: "Aprender haciendo 👨‍💻.",
  description:
    "Soy Julián Luna, AWS Community Builder con más de 10 años en tecnología. Aprende conmigo desarrollo de software, arquitectura y habilidades blandas, y conecta con una comunidad que crece contigo.",
  daughterName: "❤ Nikol Daniela",
  ctas: [
    {
      text: "Unirme a la comunidad",
      link: "/tryckers",
    },
    {
      text: "Ver contenido",
      link: "#contenido",
    },
  ],
}
---

<section class="landing-section landing-intro">
  <div class="landing-shell">
    <div
      class="text-center"
    >
      <!-- Imagen de perfil -->
      <div class="flex justify-center">
        <Image
          src={profile}
          alt={info.altProfile}
          width={240}
          height={240}
          loading="eager"
          fetchpriority="high"
          class="landing-profile"
        />
      </div>

      <!-- Información del perfil -->
      <div class="mt-6 max-w-5xl mx-auto">
        <h1
          class="text-white"
        >
          {info.title}
        </h1>
        <p class="text-base lg:text-xl text-tc-gray mt-3">{info.subtitle}</p>
        <p
          class="landing-lead"
        >
          {info.description}
        </p>
        <p class="text-tc-yellow font-semibold mt-3">{info.daughterName}</p>
      </div>

      <!-- Botones de CTA -->
      <div class="landing-actions mt-6">
        {
          info.ctas.map((cta, index) => (
            <a href={cta.link} class:list={["landing-button", index === 0 ? "landing-button-primary" : "landing-button-secondary"]}>
              {cta.text}
              <Icon name="mdi:arrow-right" class="w-4 h-4 shrink-0" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
