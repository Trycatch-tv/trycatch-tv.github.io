---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import kaddoLogo from "../../../assets/img/kaddo-logo.webp"

const links = [
  { name: "Conocer Kaddo", url: "https://kaddo.org/", icon: "mdi:arrow-top-right" },
  { name: "Comenzar", url: "https://kaddo.org/getting-started/", icon: "mdi:book-open-outline" },
  { name: "GitHub", url: "https://github.com/Kaddo-kdd/kaddo", icon: "mdi:github" },
]
---

<section id="kaddo" aria-labelledby="kaddo-title" class="bg-tc-black border-y border-gray-700 mb-12">
  <div class="px-6 py-12 lg:px-12 lg:py-16 mx-auto max-w-screen-2xl">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-tc-yellow text-sm font-semibold mb-5">Open source · Knowledge Driven Development</p>
      <h2 id="kaddo-title">
        <Image src={kaddoLogo} alt="Kaddo" width={300} class="w-56 sm:w-72 h-auto mx-auto" />
      </h2>
      <p class="text-white text-xl lg:text-2xl font-bold mt-6 leading-snug text-justify">
        El conocimiento de tu proyecto, conectado con tu código.
      </p>
      <p class="text-gray-300 text-base leading-relaxed mt-4 text-justify">
        Kaddo organiza el contexto de negocio, producto, arquitectura y entrega
        para que tu equipo y tus agentes de IA comprendan el sistema.
        Acompaña cada cambio desde la idea hasta la implementación y su verificación,
        en proyectos nuevos, existentes y legacy.
      </p>
      <p class="text-tc-cyan text-sm font-semibold mt-6">CLI · MCP · Admin · Agentes</p>
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        {links.map((link, index) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex items-center justify-center gap-2 rounded-lg px-5 py-3 text-sm font-bold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tc-yellow",
              index === 0
                ? "bg-tc-yellow text-black hover:bg-yellow-200"
                : "border border-gray-600 text-white hover:border-white hover:bg-tc-black-l",
            ]}
          >
            <Icon name={link.icon} class="w-5 h-5 shrink-0" />
            {link.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
