---
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"
import CoverBucaramanga from "../../../assets/img/comunidades/bucaramanga/cover.jpg"
import CoverBogota from "../../../assets/img/comunidades/bogota/cover.jpg"
import CoverMedellin from "../../../assets/img/comunidades/medellin/encuentros/cover.JPG"

const info = {
  title: "Comunidad Trycker",
  subtitle:
    "Esto es más que una comunidad: es una tribu tech para aprender, compartir, conocer gente y crecer juntos.",
  cities: [
    {
      title: "Bucaramanga",
      href: "/comunidades/bucaramanga",
      status: "Activa",
      description:
        "Encuentros locales para compartir experiencias, aprender y construir comunidad.",
      cover: CoverBucaramanga,
    },
    {
      title: "Bogotá",
      href: "/comunidades/bogota",
      status: "Activa",
      description:
        "Encuentros para conectar, compartir aprendizajes y fortalecer la comunidad tech de Bogotá.",
      cover: CoverBogota,
    },
    {
      title: "Medellín",
      href: "/comunidades/medellin",
      status: "Activa",
      description: "Encuentros presenciales para conversar sobre tecnología, compartir experiencias y construir comunidad.",
      cover: CoverMedellin,
    },
  ],
}
---

<section id="comunidad" aria-labelledby="comunidad-title" class="landing-section">
  <div class="landing-shell">
    <div class="landing-header">
      <h2 id="comunidad-title" class="landing-title flex items-center justify-center gap-3">
        <Icon class="landing-icon" name="mdi:account-group-outline" />
        <span>{info.title}</span>
      </h2>
      <p class="landing-lead">{info.subtitle}</p>
      <div class="landing-actions mt-6">
        <a href="https://chat.whatsapp.com/G2aXPLC8Kc382MRVdLsJyG?mode=gi_t" target="_blank" rel="noopener noreferrer" class="landing-button landing-button-primary">
          <Icon name="mdi:whatsapp" class="w-5 h-5 shrink-0" />
          Unirme a la comunidad
        </a>
        <a href="/tryckers" class="landing-button landing-button-secondary">
          Explorar la comunidad
          <Icon name="mdi:arrow-right" class="w-4 h-4 shrink-0" />
        </a>
      </div>
    </div>
    <div class="landing-grid landing-three-grid">
      {info.cities.map((item) => (
        <article class="landing-card flex flex-col">
          <Image src={item.cover} alt={`Portada ${item.title}`} class="landing-city-image mb-4" />
          <div class="flex items-center justify-between gap-2">
            <h3 class="landing-card-title">{item.title}</h3>
            <span class="text-xs font-semibold text-emerald-300">{item.status}</span>
          </div>
          <p class="landing-copy mt-3 mb-5">{item.description}</p>
          <a href={item.href} class="mt-auto inline-flex items-center gap-2 text-tc-yellow text-sm font-semibold hover:underline">
            Ver encuentros
            <span class="sr-only">de {item.title}</span>
            <Icon name="mdi:arrow-right" class="w-4 h-4 shrink-0" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
