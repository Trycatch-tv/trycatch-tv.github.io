---
import BlogSearch from "../components/landing/blog/BlogSearch.jsx"
import BaseLayout from "../layouts/BaseLayout.astro"
const allPosts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true }),
) as Array<{
  url: string
  frontmatter: {
    date: string
    title: string
    author: string
  }
}>
const posts = allPosts.sort((a, b) => {
  return (
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
  )
})

// Obtener parámetros de búsqueda desde la URL SSR
const url = new URL(Astro.request.url)
const q = url.searchParams.get("q") || ""
const searchQuery = q.toLowerCase()

const filteredPosts = posts.filter(
  (post) =>
    post.frontmatter.title.toLowerCase().includes(searchQuery) ||
    post.frontmatter.author.toLowerCase().includes(searchQuery),
)
---

<BaseLayout title="Blog | TryCatch.tv">
  <div
    class="site-container"
  >
    <h1 class="text-4xl mb-4 font-bold text-white">
      TryCatch.tv | Blog
    </h1>
    <div class="border-b-2 border-tc-black-l mb-8"></div>
    <h2 class="text-2xl mb-8 text-white">
      Últimas entradas:
    </h2>

    <BlogSearch
      client:load
      posts={posts.map((post) => ({
        url: post.url,
        frontmatter: post.frontmatter,
      }))}
    />
  </div>
</BaseLayout>
